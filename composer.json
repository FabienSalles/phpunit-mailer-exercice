{
    "name": "conveycode/phpunit-mailer-exercice",
    "description": "PHPUnit training project - E-commerce email refactoring with snapshot tests",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "symfony/dotenv": "^6.4",
        "symfony/framework-bundle": "^6.4",
        "symfony/http-client": "^7.4",
        "symfony/mailer": "^6.4",
        "symfony/runtime": "^6.4",
        "symfony/twig-bundle": "^6.4",
        "symfony/yaml": "^6.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpspec/prophecy-phpunit": "^2.4",
        "phpunit/phpunit": "^10.5",
        "spatie/phpunit-snapshot-assertions": "^5.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    }
}
